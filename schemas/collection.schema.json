{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api-explorer.dev/schemas/collection.schema.json",
  "title": "API Explorer request collection",
  "type": "object",
  "required": ["requests"],
  "properties": {
    "requests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["endpoint"],
        "properties": {
          "endpoint": {"type": "string", "minLength": 1},
          "body_file": {"type": "string"},
          "params": {
            "type": "object",
            "additionalProperties": {
              "type": ["string", "number", "boolean", "null"]
            }
          },
          "headers": {
            "type": "object",
            "additionalProperties": {"type": "string"}
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
